{
  "name": "Cube",
  "short_name": "Cube",
  "description": "Keep a paper Vintage Cube in order: the In-box Printings and the Scan diff.",
  "id": "/cube/",
  "start_url": "/cube/#/scan",
  "scope": "/cube/",
  "display": "standalone",
  "theme_color": "#fbfaf7",
  "background_color": "#fbfaf7",
  "icons": [
    { "src": "/cube/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/cube/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/cube/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/cube/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "csv",
          "accept": ["text/csv", "text/comma-separated-values", ".csv", "text/plain"]
        }
      ]
    }
  }
}
